{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kane-fabric.invalid/schema/administrative-descriptor-v1.json",
  "title": "Kane Fabric Administrative Descriptor v1",
  "type": "object",
  "required": ["format", "format_version", "descriptor_id", "descriptor_version", "title", "scope", "authorities", "pages"],
  "properties": {
    "format": { "const": "kane-fabric-administrative-descriptor" },
    "format_version": { "const": 1 },
    "descriptor_id": { "type": "string", "minLength": 1 },
    "descriptor_version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "help": { "type": "string" },
    "scope": { "type": "object" },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "citation"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "citation": { "type": "string", "minLength": 1 },
          "url": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } }
  },
  "$defs": {
    "layout": {
      "type": "object",
      "properties": {
        "row": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 },
        "span": { "type": "integer", "minimum": 1 },
        "columns": { "type": "integer", "minimum": 1 }
      }
    },
    "authorityRefs": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "control": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["text", "number", "date", "select", "textarea", "checkbox", "notice", "collection"] },
        "label": { "type": "string" },
        "binding": { "type": "string" },
        "text": { "type": "string" },
        "help": { "type": "string" },
        "data_role": { "type": "string" },
        "unit": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "required": { "type": "boolean" },
        "readonly": { "type": "boolean" },
        "disabled": { "type": "boolean" },
        "default": {},
        "placeholder": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "rows": { "type": "integer", "minimum": 1 },
        "cols": { "type": "integer", "minimum": 1 },
        "layout": { "$ref": "#/$defs/layout" },
        "authority_refs": { "$ref": "#/$defs/authorityRefs" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string" },
              "label": { "type": "string" }
            }
          }
        },
        "visible_when": {
          "type": "object",
          "required": ["binding", "equals"],
          "properties": {
            "binding": { "type": "string", "minLength": 1 },
            "equals": {}
          }
        },
        "min_items": { "type": "integer", "minimum": 0 },
        "item_label": { "type": "string" },
        "item_layout": { "$ref": "#/$defs/layout" },
        "item_controls": { "type": "array", "items": { "$ref": "#/$defs/control" } },
        "actions": {
          "type": "object",
          "properties": {
            "add_label": { "type": "string" },
            "remove_label": { "type": "string" }
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": ["id", "title", "controls"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "layout": { "$ref": "#/$defs/layout" },
        "authority_refs": { "$ref": "#/$defs/authorityRefs" },
        "controls": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/control" } }
      }
    },
    "page": {
      "type": "object",
      "required": ["id", "title", "sections"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "help": { "type": "string" },
        "sections": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/section" } }
      }
    }
  }
}
